<mvc:View
    controllerName="o2c.controller.CreditCheck"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:f="sap.ui.layout.form"
    xmlns:core="sap.ui.core">

    <Page title="{i18n>pageCreditCheck}">
        <customHeader>
            <Bar>
                <contentLeft>
                    <Button icon="sap-icon://nav-back" press=".navBack" />
                    <Title text="{i18n>pageCustomerCreditCheck}" />
                </contentLeft>
            </Bar>
        </customHeader>

        <content>
            <VBox class="sapUiMediumMargin">

                <!-- Check Form -->
                <Panel headerText="{i18n>btnRunCreditCheck}" expandable="false" class="sapUiSmallMarginBottom">
                    <f:SimpleForm editable="true" layout="ColumnLayout" columnsL="2" columnsM="1">
                        <f:content>
                            <Label text="{i18n>colCustomer}" required="true" />
                            <Select id="ccCustomer" selectedKey="">
                                <core:Item key="" text="{i18n>selectCustomer}" />
                            </Select>

                            <Label text="Order Amount (â‚¹)" required="true" />
                            <Input id="ccAmount" type="Number" placeholder="{i18n>phOrderAmount}" />
                        </f:content>
                    </f:SimpleForm>
                    <HBox class="sapUiSmallMargin">
                        <Button text="{i18n>btnRunCreditCheck}" icon="sap-icon://credit-card"
                                type="Emphasized" press=".onRunCheck" />
                        <Button text="{i18n>btnReset}" icon="sap-icon://refresh"
                                type="Default" press=".onReset" class="sapUiSmallMarginBegin" />
                    </HBox>
                </Panel>

                <!-- Result Panel -->
                <Panel id="resultPanel" headerText="{i18n>pageCreditCheck}"
                       expandable="false" visible="false">
                    <VBox class="sapUiSmallMargin">

                        <!-- Status Banner -->
                        <MessageStrip id="creditResultStrip" text="" type="Success"
                                      showIcon="true" class="sapUiSmallMarginBottom" />

                        <!-- Details -->
                        <f:SimpleForm editable="false" layout="ColumnLayout" columnsL="3" columnsM="2">
                            <f:content>
                                <Label text="{i18n>colCustomer}" />
                                <Text id="resCustomerName" text="" />

                                <Label text="{i18n>colCreditLimit}" />
                                <ObjectNumber id="resCreditLimit" number="" state="None" />

                                <Label text="{i18n>colUsedCredit}" />
                                <ObjectNumber id="resUsedCredit" number="" state="None" />

                                <Label text="{i18n>colAvailable}" />
                                <ObjectNumber id="resAvailCredit" number="" state="None" />

                                <Label text="{i18n>labelOrderAmount}" />
                                <ObjectNumber id="resOrderAmount" number="" state="None" />

                                <Label text="{i18n>colUtilization}" />
                                <Text id="resCreditUtil" text="" />
                            </f:content>
                        </f:SimpleForm>

                        <!-- Progress Bar -->
                        <Label text="{i18n>labelCreditUtilizationAfterOrder}" class="sapUiSmallMarginTop" />
                        <ProgressIndicator id="creditProgress" percentValue="0"
                                           displayValue="0%" showValue="true" state="Success"
                                           class="sapUiSmallMarginBottom" />

                        <!-- Recommendation -->
                        <Panel headerText="{i18n>labelRecommendation}" class="sapUiSmallMarginTop">
                            <Text id="resRecommendation" text="" class="sapUiSmallMargin"
                                  wrapping="true" />
                        </Panel>
                    </VBox>
                </Panel>

                <!-- All Customers Credit Overview -->
                <Panel headerText="{i18n>pageCustomerCreditCheck}" expandable="true" expanded="true"
                       class="sapUiSmallMarginTop">
                    <Table items="{/customers}" noDataText="{i18n>noCustomer}">
                        <columns>
                            <Column><Text text="{i18n>colCustomer}" /></Column>
                            <Column hAlign="End"><Text text="{i18n>colCreditLimit}" /></Column>
                            <Column hAlign="End"><Text text="{i18n>colUsedCredit}" /></Column>
                            <Column hAlign="End"><Text text="{i18n>statusAvailable}" /></Column>
                            <Column hAlign="Center"><Text text="{i18n>colUtilization}" /></Column>
                            <Column hAlign="Center"><Text text="{i18n>colStatus}" /></Column>
                        </columns>
                        <items>
                            <ColumnListItem>
                                <cells>
                                    <ObjectIdentifier title="{CustomerName}" text="{CustomerId}" />
                                    <ObjectNumber number="{path:'CreditLimit', formatter:'.formatCurrency'}" />
                                    <ObjectNumber number="{path:'UsedCredit', formatter:'.formatCurrency'}"
                                                  state="{path:'UsedCredit', formatter:'.formatUsedState'}" />
                                    <ObjectNumber number="{path:'CreditLimit', formatter:'.formatAvail'}"
                                                  state="Success" />
                                    <ProgressIndicator
                                        percentValue="{path: 'CreditLimit', formatter: '.fmtPct'}"
                                        showValue="true" width="120px"
                                        state="{path: 'CreditLimit', formatter: '.fmtPctState'}" />
                                    <ObjectStatus text="{Status}"
                                                  state="{path:'Status', formatter:'.formatStatusState'}" />
                                </cells>
                            </ColumnListItem>
                        </items>
                    </Table>
                </Panel>

            </VBox>
        </content>
    </Page>
</mvc:View>

