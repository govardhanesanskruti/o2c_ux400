<mvc:View
    controllerName="o2c.controller.Invoices"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core">

    <Page title="{i18n>pageInvoices}">
        <customHeader>
            <Bar>
                <contentLeft>
                    <Button icon="sap-icon://nav-back" press=".navBack" />
                    <Title text="{i18n>pageInvoiceManagement}" />
                </contentLeft>
                <contentRight>
                    <Select id="invoiceFilter" change=".onFilterChange">
                        <core:Item key="All"     text="{i18n>statusAll}" />
                        <core:Item key="Pending" text="{i18n>statusPending}" />
                        <core:Item key="Paid"    text="{i18n>statusPaid}" />
                        <core:Item key="Overdue" text="{i18n>statusOverdue}" />
                    </Select>
                </contentRight>
            </Bar>
        </customHeader>

        <content>
            <VBox class="sapUiMediumMargin">

                <!-- Summary Tiles -->
                <HBox class="sapUiSmallMarginBottom" wrap="Wrap">

                    <GenericTile header="Total Invoiced" subheader="All invoices"
                                 backgroundColor="#107E3E"
                                 class="sapUiSmallMarginEnd sapUiSmallMarginBottom">
                        <tileContent>
                            <TileContent unit="INR">
                                <!--
                                    FIX: .reduce() inside expression binding crashes UI5 parser.
                                    Use formatter function in controller instead.
                                -->
                                <NumericContent
                                    value="{path:'/invoices', formatter:'.calcTotalInvoiced'}"
                                    scale="L" valueColor="Good" withMargin="false" />
                            </TileContent>
                        </tileContent>
                    </GenericTile>

                    <GenericTile header="Overdue Invoices" subheader="Needs Attention"
                                 backgroundColor="#BB0000"
                                 class="sapUiSmallMarginEnd sapUiSmallMarginBottom">
                        <tileContent>
                            <TileContent unit="Invoices">
                                <!--
                                    FIX: .filter() inside expression binding crashes UI5 parser.
                                    Use formatter function in controller instead.
                                -->
                                <NumericContent
                                    value="{path:'/invoices', formatter:'.calcOverdueCount'}"
                                    valueColor="Critical" withMargin="false" />
                            </TileContent>
                        </tileContent>
                    </GenericTile>

                    <GenericTile header="Pending Payment" subheader="Awaiting"
                                 backgroundColor="#E76500"
                                 class="sapUiSmallMarginBottom">
                        <tileContent>
                            <TileContent unit="Invoices">
                                <!--
                                    FIX: .filter() inside expression binding crashes UI5 parser.
                                    Use formatter function in controller instead.
                                -->
                                <NumericContent
                                    value="{path:'/invoices', formatter:'.calcPendingCount'}"
                                    valueColor="Neutral" withMargin="false" />
                            </TileContent>
                        </tileContent>
                    </GenericTile>

                </HBox>

                <!-- Invoices Table â€” all row-level bindings were fine, kept as-is -->
                <Table id="invoicesTable" items="{/invoices}"
                       noDataText="{i18n>noInvoices}"
                       growing="true" growingThreshold="10"
                       alternateRowColors="true" showSeparators="Inner">
                    <headerToolbar>
                        <Toolbar>
                            <core:Icon src="sap-icon://document-text" color="#0070F3" class="sapUiTinyMarginEnd" />
                            <Title text="{i18n>pageInvoices}" />
                            <ToolbarSpacer />
                            <Button icon="sap-icon://refresh" press=".onRefresh" tooltip="{i18n>tooltipRefresh}" type="Transparent" />
                        </Toolbar>
                    </headerToolbar>
                    <columns>
                        <Column><Text text="{i18n>colInvoiceId}" /></Column>
                        <Column><Text text="{i18n>colOrderId}" /></Column>
                        <Column><Text text="{i18n>colInvoiceDate}" /></Column>
                        <Column hAlign="End"><Text text="Amount (â‚¹)" /></Column>
                        <Column><Text text="{i18n>colDueDate}" /></Column>
                        <Column hAlign="Center"><Text text="{i18n>colStatus}" /></Column>
                        <Column hAlign="Center"><Text text="{i18n>colActions}" /></Column>
                    </columns>
                    <items>
                        <ColumnListItem type="Active"
                            highlight="{path:'InvoiceStatus', formatter:'.formatStatusState'}">
                            <cells>
                                <ObjectIdentifier title="{InvoiceId}" />
                                <Link text="{OrderId}" press=".onOrderLink" />
                                <Text text="{InvoiceDate}" />
                                <ObjectNumber number="{path:'Amount', formatter:'.formatCurrency'}"
                                              state="None" emphasized="true" />
                                <Text text="{DueDate}" />
                                <ObjectStatus text="{InvoiceStatus}"
                                              state="{path:'InvoiceStatus', formatter:'.formatStatusState'}"
                                              inverted="true" />
                                <HBox>
                                    <!-- Row-level single-property expressions are fine -->
                                    <Button text="{i18n>btnRecordPayment}" icon="sap-icon://payment-approval"
                                            type="Transparent" press=".onRecordPayment"
                                            visible="{= ${InvoiceStatus} !== 'Paid'}" />
                                    <Button text="{i18n>btnMarkOverdue}" icon="sap-icon://alert"
                                            type="Transparent" press=".onMarkOverdue"
                                            visible="{= ${InvoiceStatus} === 'Pending'}" />
                                </HBox>
                            </cells>
                        </ColumnListItem>
                    </items>
                </Table>

            </VBox>
        </content>

        <!-- Payment Dialog â€” unchanged -->
        <dependents>
            <Dialog id="paymentDialog" title="{i18n>btnRecordPayment}" contentWidth="420px">
                <content>
                    <VBox class="sapUiSmallMargin">
                        <Label text="{i18n>colInvoiceId}" />
                        <Text id="payInvoiceId" text="" class="sapUiSmallMarginBottom" />
                        <Label text="{i18n>labelInvoiceAmount}" />
                        <Text id="payInvoiceAmt" text="" class="sapUiSmallMarginBottom" />
                        <Label text="Amount Paid (â‚¹)" required="true" />
                        <Input id="payAmount" type="Number" placeholder="{i18n>phAmountPaid}"
                               class="sapUiSmallMarginBottom" />
                        <Label text="{i18n>colPaymentMode}" required="true" />
                        <Select id="payMode" class="sapUiSmallMarginBottom">
                            <core:Item key="NEFT"   text="NEFT" />
                            <core:Item key="RTGS"   text="RTGS" />
                            <core:Item key="Cheque" text="Cheque" />
                            <core:Item key="UPI"    text="UPI" />
                            <core:Item key="Cash"   text="Cash" />
                        </Select>
                        <Label text="{i18n>colPaymentDate}" required="true" />
                        <DatePicker id="payDate" value=""
                                    displayFormat="yyyy-MM-dd" valueFormat="yyyy-MM-dd"
                                    class="sapUiSmallMarginBottom" />
                        <Label text="{i18n>colRemarks}" />
                        <TextArea id="payRemarks" rows="2" placeholder="{i18n>phOptionalRemarks}" />
                    </VBox>
                </content>
                <beginButton>
                    <Button text="{i18n>btnRecordPayment}" type="Emphasized" press=".onConfirmPayment" />
                </beginButton>
                <endButton>
                    <Button text="{i18n>btnCancel}" press=".onCancelPayment" />
                </endButton>
            </Dialog>
        </dependents>

    </Page>
</mvc:View>

