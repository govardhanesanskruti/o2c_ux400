<mvc:View
    controllerName="o2c.controller.CustomerCreate"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:f="sap.ui.layout.form"
    xmlns:core="sap.ui.core">

    <Page title="{i18n>pageCreateCustomer}" showNavButton="true" navButtonPress=".navBack">
        <customHeader>
            <Bar>
                <contentLeft>
                    <Button icon="sap-icon://nav-back" press=".navBack" />
                    <Title text="{i18n>btnNewCustomer}" />
                </contentLeft>
                <contentRight>
                    <Button text="{i18n>btnSave}" type="Emphasized" icon="sap-icon://save" press=".onSave" />
                    <Button text="{i18n>btnCancel}" type="Default" press=".navBack" />
                </contentRight>
            </Bar>
        </customHeader>

        <content>
            <VBox class="sapUiMediumMargin">
                <f:SimpleForm id="customerForm" editable="true"
                              layout="ColumnLayout" columnsL="2" columnsM="2"
                              title="{i18n>labelCustomerInfo}">
                    <f:content>
                        <Label text="{i18n>colCustomerId}" required="true" />
                        <Input id="customerId" placeholder="{i18n>phAutoGenerated}" enabled="false"
                               value="{/newCustomer/CustomerId}" />

                        <Label text="{i18n>colCustomerName}" required="true" />
                        <Input id="customerName" placeholder="{i18n>phCustomerName}"
                               value="{/newCustomer/CustomerName}"
                               valueLiveUpdate="true" />

                        <Label text="{i18n>labelEmailAddress}" required="true" />
                        <Input id="customerEmail" placeholder="{i18n>phEmail}"
                               value="{/newCustomer/Email}" type="Email" />

                        <Label text="{i18n>labelPhoneNumber}" required="true" />
                        <Input id="customerPhone" placeholder="{i18n>phPhone}"
                               value="{/newCustomer/Phone}" type="Tel" />

                        <Label text="{i18n>colAddress}" required="true" />
                        <TextArea id="customerAddress" placeholder="{i18n>phAddress}"
                                  value="{/newCustomer/Address}" rows="3" growing="true" />

                        <Label text="Credit Limit (â‚¹)" required="true" />
                        <Input id="customerCreditLimit" placeholder="{i18n>phCreditLimit}"
                               value="{/newCustomer/CreditLimit}" type="Number" />

                        <Label text="{i18n>colStatus}" />
                        <Select id="customerStatus" selectedKey="{/newCustomer/Status}">
                            <core:Item key="Active" text="{i18n>statusActive}" />
                            <core:Item key="On Hold" text="{i18n>statusOnHold}" />
                            <core:Item key="Inactive" text="{i18n>statusInactive}" />
                        </Select>
                    </f:content>
                </f:SimpleForm>
            </VBox>
        </content>
    </Page>
</mvc:View>

