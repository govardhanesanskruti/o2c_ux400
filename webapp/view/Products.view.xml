<mvc:View
    controllerName="o2c.controller.Products"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core">

    <Page title="{i18n>pageProducts}">
        <customHeader>
            <Bar>
                <contentLeft>
                    <Button icon="sap-icon://nav-back" press=".navBack" />
                    <Title text="{i18n>pageProductMasterData}" />
                </contentLeft>
                <contentRight>
                    <SearchField placeholder="{i18n>searchProducts}" search=".onSearch"
                                 liveChange=".onSearch" width="250px" />
                    <Select id="categoryFilter" change=".onCategoryFilter">
                        <core:Item key="All" text="{i18n>allCategories}" />
                        <core:Item key="Software" text="Software" />
                        <core:Item key="Hardware" text="Hardware" />
                        <core:Item key="Services" text="Services" />
                    </Select>
                </contentRight>
            </Bar>
        </customHeader>

        <content>
            <Table id="productTable" items="{/products}"
                   noDataText="{i18n>noProducts}"
                   growing="true" growingThreshold="10">
                <headerToolbar>
                    <Toolbar>
                        <Title text="Products ({= ${/products} ? ${/products}.length : 0})" />
                        <ToolbarSpacer />
                        <Button text="{i18n>btnAddProduct}" icon="sap-icon://add" type="Emphasized"
                                press=".onAddProduct" />
                    </Toolbar>
                </headerToolbar>
                <columns>
                    <Column width="8rem"><Text text="{i18n>colProductId}" /></Column>
                    <Column><Text text="{i18n>colProductName}" /></Column>
                    <Column><Text text="{i18n>colCategory}" /></Column>
                    <Column hAlign="End"><Text text="Unit Price (â‚¹)" /></Column>
                    <Column hAlign="Center"><Text text="{i18n>colStock}" /></Column>
                    <Column hAlign="Center"><Text text="{i18n>colStatus}" /></Column>
                    <Column hAlign="Center"><Text text="{i18n>colActions}" /></Column>
                </columns>
                <items>
                    <ColumnListItem type="Active">
                        <cells>
                            <ObjectIdentifier title="{ProductId}" />
                            <ObjectIdentifier title="{ProductName}" />
                            <ObjectAttribute text="{Category}" />
                            <ObjectNumber number="{path:'Price', formatter:'.formatCurrency'}" state="None" />
                            <ObjectNumber number="{Stock}" unit="units"
                                          state="{path:'Stock', formatter:'.formatStockState'}" />
                            <ObjectStatus text="{Status}" state="{path:'Status', formatter:'.formatStatusState'}" />
                            <HBox>
                                <Button icon="sap-icon://edit" type="Transparent" press=".onEditProduct" />
                            </HBox>
                        </cells>
                    </ColumnListItem>
                </items>
            </Table>
        </content>

        <!-- Add Product Dialog -->
        <dependents>
            <Dialog id="addProductDialog" title="{i18n>dialogAddProduct}" contentWidth="500px">
                <content>
                    <VBox class="sapUiSmallMargin">
                        <Label text="{i18n>colProductName}" required="true" />
                        <Input id="newProdName" placeholder="{i18n>phProductName}" class="sapUiSmallMarginBottom" />
                        <Label text="{i18n>colCategory}" required="true" />
                        <Select id="newProdCategory" class="sapUiSmallMarginBottom">
                            <core:Item key="Software" text="Software" />
                            <core:Item key="Hardware" text="Hardware" />
                            <core:Item key="Services" text="Services" />
                        </Select>
                        <Label text="Unit Price (â‚¹)" required="true" />
                        <Input id="newProdPrice" type="Number" placeholder="0" class="sapUiSmallMarginBottom" />
                        <Label text="{i18n>colStockQuantity}" required="true" />
                        <Input id="newProdStock" type="Number" placeholder="0" class="sapUiSmallMarginBottom" />
                    </VBox>
                </content>
                <beginButton>
                    <Button text="{i18n>btnSave}" type="Emphasized" press=".onSaveProduct" />
                </beginButton>
                <endButton>
                    <Button text="{i18n>btnCancel}" press=".onCancelProduct" />
                </endButton>
            </Dialog>
        </dependents>
    </Page>
</mvc:View>

