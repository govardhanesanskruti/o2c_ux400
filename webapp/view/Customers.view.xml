<mvc:View
    controllerName="o2c.controller.Customers"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core">

    <Page title="{i18n>pageCustomers}" showNavButton="true" navButtonPress=".navBack">
        <customHeader>
            <Bar>
                <contentLeft>
                    <Button icon="sap-icon://nav-back" press=".navBack" />
                    <Title text="{i18n>pageCustomerMasterData}" />
                </contentLeft>
                <contentRight>
                    <SearchField id="customerSearch" placeholder="{i18n>searchCustomers}"
                                 search=".onSearch" width="250px" liveChange=".onSearch" />
                    <Button text="{i18n>btnNewCustomer}" icon="sap-icon://add-contact"
                            type="Emphasized" press=".onCreateCustomer" />
                </contentRight>
            </Bar>
        </customHeader>

        <content>
            <Table id="customerTable"
                   items="{path: '/customers'}"
                   mode="SingleSelectLeft"
                   selectionChange=".onCustomerSelect"
                   noDataText="{i18n>noCustomers}"
                   growing="true" growingThreshold="10">

                <headerToolbar>
                    <Toolbar>
                        <Title text="Customers ({= ${/customers} ? ${/customers}.length : 0})" />
                        <ToolbarSpacer />
                        <Button icon="sap-icon://refresh" press=".onRefresh" tooltip="{i18n>tooltipRefresh}" />
                    </Toolbar>
                </headerToolbar>

                <columns>
                    <Column width="8rem"><Text text="{i18n>colCustomerId}" /></Column>
                    <Column minScreenWidth="Tablet" demandPopin="true"><Text text="{i18n>colCustomerName}" /></Column>
                    <Column minScreenWidth="Tablet" demandPopin="true"><Text text="{i18n>colEmail}" /></Column>
                    <Column minScreenWidth="Desktop" demandPopin="true"><Text text="{i18n>colPhone}" /></Column>
                    <Column hAlign="End"><Text text="{i18n>colCreditLimit}" /></Column>
                    <Column hAlign="End"><Text text="{i18n>colUsedCredit}" /></Column>
                    <Column hAlign="Center"><Text text="{i18n>colStatus}" /></Column>
                    <Column hAlign="Center"><Text text="{i18n>colActions}" /></Column>
                </columns>

                <items>
                    <ColumnListItem type="Navigation" press=".onCustomerPress">
                        <cells>
                            <ObjectIdentifier title="{CustomerId}" />
                            <ObjectIdentifier title="{CustomerName}" />
                            <Link text="{Email}" href="mailto:{Email}" />
                            <Text text="{Phone}" />
                            <ObjectNumber number="{path:'CreditLimit', formatter:'.formatCurrency'}" state="None" />
                            <ObjectNumber number="{path:'UsedCredit', formatter:'.formatCurrency'}"
                                          state="{path:'UsedCredit', formatter:'.formatCreditState'}" />
                            <ObjectStatus text="{Status}" state="{path:'Status', formatter:'.formatStatusState'}" />
                            <HBox>
                                <Button icon="sap-icon://edit" type="Transparent" press=".onEditCustomer" />
                                <Button icon="sap-icon://delete" type="Transparent" press=".onDeleteCustomer" />
                            </HBox>
                        </cells>
                    </ColumnListItem>
                </items>
            </Table>
        </content>
    </Page>
</mvc:View>

