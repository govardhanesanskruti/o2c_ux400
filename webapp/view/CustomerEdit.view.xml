<mvc:View
    controllerName="o2c.controller.CustomerEdit"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:f="sap.ui.layout.form"
    xmlns:core="sap.ui.core">

    <Page title="Edit Customer" showNavButton="true" navButtonPress=".navBack">
        <customHeader>
            <Bar>
                <contentLeft>
                    <Button icon="sap-icon://nav-back" press=".navBack" />
                    <Title text="Edit Customer - {/editCustomer/CustomerId}" />
                </contentLeft>
                <contentRight>
                    <Button text="Save Changes" type="Emphasized" icon="sap-icon://save" press=".onSave" />
                    <Button text="Cancel" type="Default" press=".navBack" />
                </contentRight>
            </Bar>
        </customHeader>

        <content>
            <VBox class="sapUiMediumMargin">
                <f:SimpleForm editable="true" layout="ColumnLayout" columnsL="2" columnsM="2"
                              title="Edit Customer Information">
                    <f:content>
                        <Label text="Customer ID" />
                        <Input value="{/editCustomer/CustomerId}" enabled="false" />

                        <Label text="Customer Name" required="true" />
                        <Input id="editName" value="{/editCustomer/CustomerName}" placeholder="Customer name" />

                        <Label text="Email Address" required="true" />
                        <Input id="editEmail" value="{/editCustomer/Email}" type="Email" />

                        <Label text="Phone Number" required="true" />
                        <Input id="editPhone" value="{/editCustomer/Phone}" type="Tel" />

                        <Label text="Address" required="true" />
                        <TextArea id="editAddress" value="{/editCustomer/Address}" rows="3" />

                        <Label text="Credit Limit (₹)" required="true" />
                        <Input id="editCreditLimit" value="{/editCustomer/CreditLimit}" type="Number" />

                        <Label text="Used Credit (₹)" />
                        <Input value="{/editCustomer/UsedCredit}" enabled="false" />

                        <Label text="Status" />
                        <Select selectedKey="{/editCustomer/Status}">
                            <core:Item key="Active" text="Active" />
                            <core:Item key="On Hold" text="On Hold" />
                            <core:Item key="Inactive" text="Inactive" />
                        </Select>
                    </f:content>
                </f:SimpleForm>

                <!-- Credit Utilization -->
                <Panel headerText="Credit Utilization" class="sapUiSmallMarginTop">
                    <HBox class="sapUiSmallMargin" alignItems="Center">
                        <VBox width="100%">
                            <HBox justifyContent="SpaceBetween">
                                <Label text="Used: ₹{/editCustomer/UsedCredit}" />
                                <Label text="Limit: ₹{/editCustomer/CreditLimit}" />
                            </HBox>
                            <ProgressIndicator
                                percentValue="{path: '/editCustomer', formatter: '.calcCreditPercent'}"
                                displayValue="{path: '/editCustomer', formatter: '.calcCreditPercentText'}"
                                state="{path: '/editCustomer', formatter: '.calcCreditState'}"
                                showValue="true" />
                        </VBox>
                    </HBox>
                </Panel>
            </VBox>
        </content>
    </Page>
</mvc:View>