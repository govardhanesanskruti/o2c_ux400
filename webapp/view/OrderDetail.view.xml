<mvc:View
    controllerName="o2c.controller.OrderDetail"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:f="sap.ui.layout.form">

    <Page title="{i18n>pageOrderDetail}" showNavButton="true" navButtonPress=".navBack">
        <customHeader>
            <Bar>
                <contentLeft>
                    <Button icon="sap-icon://nav-back" press=".navBack" />
                    <Title text="{= ${i18n>pageOrderDetail} + ' - ' + ${/selectedOrder/OrderId} }" />
                </contentLeft>
                <contentRight>
                    <Button text="{i18n>btnGenerateInvoice}" icon="sap-icon://invoice" type="Emphasized"
                            press=".onGenerateInvoice"
                            visible="{= ${/selectedOrder/OrderStatus} === 'Delivered' || ${/selectedOrder/OrderStatus} === 'Processing'}" />
                    <Button text="{i18n>btnUpdateStatus}" icon="sap-icon://process" type="Default"
                            press=".onUpdateStatus" />
                </contentRight>
            </Bar>
        </customHeader>

        <content>
            <VBox class="sapUiMediumMargin">

                <!-- Order Header Info -->
                <Panel headerText="{i18n>labelOrderHeader}" expandable="false" class="sapUiSmallMarginBottom">
                    <f:SimpleForm editable="false" layout="ResponsiveGridLayout" columnsL="3" columnsM="2">
                        <f:content>
                            <Label text="{i18n>colOrderId}" />
                            <Text text="{/selectedOrder/OrderId}" />

                            <Label text="{i18n>colCustomer}" />
                            <Text text="{/selectedOrder/CustomerName}" />

                            <Label text="{i18n>colCustomerId}" />
                            <Text text="{/selectedOrder/CustomerId}" />

                            <Label text="{i18n>colOrderDate}" />
                            <Text text="{/selectedOrder/OrderDate}" />

                            <Label text="{i18n>colTotalAmount}" />
                            <Text text="{path:'/selectedOrder/TotalAmount', formatter:'.formatCurrency'}" />

                            <Label text="{i18n>colCreditStatus}" />
                            <Text text="{/selectedOrder/CreditStatus}" />

                            <Label text="{i18n>colOrderStatus}" />
                            <Text text="{/selectedOrder/OrderStatus}" />
                        </f:content>
                    </f:SimpleForm>
                </Panel>

                <!-- Order Items -->
                <Panel headerText="{i18n>colLineItems}" expandable="false" class="sapUiSmallMarginBottom">
                    <Table id="orderItemsTable" items="{/selectedOrderItems}"
                           noDataText="{i18n>noItemsForOrder}">
                        <columns>
                            <Column><Text text="{i18n>colItemId}" /></Column>
                            <Column><Text text="{i18n>colProduct}" /></Column>
                            <Column hAlign="Center"><Text text="{i18n>colQuantity}" /></Column>
                            <Column hAlign="End"><Text text="{i18n>colUnitPrice}" /></Column>
                            <Column hAlign="End"><Text text="{i18n>colItemTotal}" /></Column>
                        </columns>
                        <items>
                            <ColumnListItem>
                                <cells>
                                    <Text text="{ItemId}" />
                                    <ObjectIdentifier title="{ProductName}" text="{ProductId}" />
                                    <ObjectNumber number="{Quantity}" unit="units" />
                                    <ObjectNumber number="{path:'UnitPrice', formatter:'.formatCurrency'}" />
                                    <ObjectNumber number="{path:'ItemTotal', formatter:'.formatCurrency'}"
                                                  state="Success" emphasized="true" />
                                </cells>
                            </ColumnListItem>
                        </items>
                    </Table>
                </Panel>

                <!-- Approval Info -->
                <Panel headerText="{i18n>pageApprovals}" expandable="false" class="sapUiSmallMarginBottom">
                    <Table items="{/selectedApproval}" noDataText="{i18n>noApprovalRecord}">
                        <columns>
                            <Column><Text text="{i18n>colApprovalId}" /></Column>
                            <Column><Text text="{i18n>colDecision}" /></Column>
                            <Column><Text text="{i18n>colRemarks}" /></Column>
                            <Column><Text text="{i18n>colApprovedBy}" /></Column>
                            <Column><Text text="{i18n>colApprovedOn}" /></Column>
                        </columns>
                        <items>
                            <ColumnListItem>
                                <cells>
                                    <Text text="{ApprovalId}" />
                                    <ObjectStatus text="{Decision}"
                                                  state="{path:'Decision', formatter:'.formatStatusState'}" />
                                    <Text text="{Remarks}" />
                                    <Text text="{ApprovedBy}" />
                                    <Text text="{ApprovedOn}" />
                                </cells>
                            </ColumnListItem>
                        </items>
                    </Table>
                </Panel>

            </VBox>
        </content>

        <!-- Update Status Dialog -->
        <dependents>
            <Dialog id="updateStatusDialog" title="{i18n>dialogUpdateOrderStatus}" contentWidth="400px">
                <content>
                    <VBox class="sapUiSmallMargin">
                        <Label text="{i18n>labelNewStatus}" required="true" />
                        <Select id="newStatusSelect" class="sapUiSmallMarginBottom">
                            <core:Item xmlns:core="sap.ui.core" key="Processing" text="{i18n>statusProcessing}" />
                            <core:Item xmlns:core="sap.ui.core" key="Shipped" text="{i18n>statusShipped}" />
                            <core:Item xmlns:core="sap.ui.core" key="Delivered" text="{i18n>statusDelivered}" />
                            <core:Item xmlns:core="sap.ui.core" key="Cancelled" text="{i18n>statusCancelled}" />
                        </Select>
                        <Label text="{i18n>colRemarks}" />
                        <TextArea id="statusRemarks" rows="3" placeholder="{i18n>phRemarks}" />
                    </VBox>
                </content>
                <beginButton>
                    <Button text="{i18n>btnUpdate}" type="Emphasized" press=".onConfirmStatusUpdate" />
                </beginButton>
                <endButton>
                    <Button text="{i18n>btnCancel}" press=".onCancelStatusUpdate" />
                </endButton>
            </Dialog>
        </dependents>
    </Page>
</mvc:View>

