<mvc:View
    controllerName="o2c.controller.Payments"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core">

    <Page title="{i18n>pagePayments}">
        <customHeader>
            <Bar>
                <contentLeft>
                    <Button icon="sap-icon://nav-back" press=".navBack" />
                    <Title text="{i18n>pagePaymentRecords}" />
                </contentLeft>
                <contentRight>
                    <Select id="payStatusFilter" change=".onFilterChange" class="sapUiTinyMarginEnd">
                        <core:Item key="All"       text="{i18n>statusAll}" />
                        <core:Item key="Completed" text="{i18n>statusCompleted}" />
                        <core:Item key="Partial"   text="{i18n>statusPartial}" />
                        <core:Item key="Pending"   text="{i18n>statusPending}" />
                    </Select>
                    <Select id="payModeFilter" change=".onFilterChange">
                        <core:Item key="All"    text="{i18n>allModes}" />
                        <core:Item key="NEFT"   text="NEFT" />
                        <core:Item key="RTGS"   text="RTGS" />
                        <core:Item key="Cheque" text="Cheque" />
                        <core:Item key="UPI"    text="UPI" />
                    </Select>
                </contentRight>
            </Bar>
        </customHeader>

        <content>
            <VBox class="sapUiMediumMargin">

                <!-- KPI Tiles -->
                <HBox class="sapUiSmallMarginBottom" wrap="Wrap">

                    <GenericTile header="Total Collected" subheader="All payments"
                                 backgroundColor="#107E3E"
                                 class="sapUiSmallMarginEnd sapUiSmallMarginBottom">
                        <tileContent>
                            <TileContent unit="INR">
                                <!--
                                    FIX: .reduce() inside expression binding crashes UI5 parser.
                                    Use formatter function in controller instead.
                                -->
                                <NumericContent
                                    value="{path:'/payments', formatter:'.calcTotalCollected'}"
                                    scale="L" valueColor="Good" withMargin="false" />
                            </TileContent>
                        </tileContent>
                    </GenericTile>

                    <GenericTile header="Completed Payments" subheader="Fully paid"
                                 backgroundColor="#0057A8"
                                 class="sapUiSmallMarginEnd sapUiSmallMarginBottom">
                        <tileContent>
                            <TileContent unit="Payments">
                                <!--
                                    FIX: .filter() inside expression binding crashes UI5 parser.
                                    Use formatter function in controller instead.
                                -->
                                <NumericContent
                                    value="{path:'/payments', formatter:'.calcCompletedCount'}"
                                    valueColor="Good" withMargin="false" />
                            </TileContent>
                        </tileContent>
                    </GenericTile>

                    <GenericTile header="Partial Payments" subheader="Pending balance"
                                 backgroundColor="#E76500"
                                 class="sapUiSmallMarginBottom">
                        <tileContent>
                            <TileContent unit="Payments">
                                <!--
                                    FIX: .filter() inside expression binding crashes UI5 parser.
                                    Use formatter function in controller instead.
                                -->
                                <NumericContent
                                    value="{path:'/payments', formatter:'.calcPartialCount'}"
                                    valueColor="Critical" withMargin="false" />
                            </TileContent>
                        </tileContent>
                    </GenericTile>

                </HBox>

                <!-- Payments Table â€” all row-level bindings were fine, kept as-is -->
                <Table id="paymentsTable" items="{/payments}"
                       noDataText="{i18n>noPayments}"
                       growing="true" growingThreshold="15"
                       alternateRowColors="true" showSeparators="Inner">
                    <headerToolbar>
                        <Toolbar>
                            <core:Icon src="sap-icon://payment-approval" color="#0070F3" class="sapUiTinyMarginEnd" />
                            <Title text="{i18n>pagePaymentRecords}" />
                            <ToolbarSpacer />
                            <Button text="{i18n>btnExport}" icon="sap-icon://excel-attachment"
                                    type="Default" press=".onExport" />
                        </Toolbar>
                    </headerToolbar>
                    <columns>
                        <Column><Text text="{i18n>colPaymentId}" /></Column>
                        <Column><Text text="{i18n>colInvoiceId}" /></Column>
                        <Column hAlign="End"><Text text="Amount Paid (â‚¹)" /></Column>
                        <Column><Text text="{i18n>colPaymentDate}" /></Column>
                        <Column hAlign="Center"><Text text="{i18n>colMode}" /></Column>
                        <Column hAlign="Center"><Text text="{i18n>colStatus}" /></Column>
                        <Column hAlign="Center"><Text text="{i18n>colActions}" /></Column>
                    </columns>
                    <items>
                        <ColumnListItem type="Active"
                            highlight="{path:'PaymentStatus', formatter:'.formatStatusState'}">
                            <cells>
                                <ObjectIdentifier title="{PaymentId}" />
                                <Link text="{InvoiceId}" press=".onInvoiceLink" />
                                <ObjectNumber number="{path:'AmountPaid', formatter:'.formatCurrency'}"
                                              state="Success" emphasized="true" />
                                <Text text="{PaymentDate}" />
                                <ObjectAttribute text="{PaymentMode}" />
                                <ObjectStatus text="{PaymentStatus}"
                                              state="{path:'PaymentStatus', formatter:'.formatStatusState'}"
                                              inverted="true" />
                                <Button icon="sap-icon://receipt" tooltip="{i18n>tooltipViewReceipt}"
                                        type="Transparent" press=".onViewReceipt" />
                            </cells>
                        </ColumnListItem>
                    </items>
                </Table>

            </VBox>
        </content>

        <!-- Receipt Dialog â€” unchanged -->
        <dependents>
            <Dialog id="receiptDialog" title="{i18n>dialogPaymentReceipt}" contentWidth="420px">
                <content>
                    <VBox class="sapUiMediumMargin">
                        <Title text="{i18n>dialogPaymentReceipt}" titleStyle="H4" class="sapUiSmallMarginBottom" />
                        <HBox justifyContent="SpaceBetween" class="sapUiSmallMarginBottom">
                            <Label text="Payment ID:" /><Text id="rcptPayId" text="" />
                        </HBox>
                        <HBox justifyContent="SpaceBetween" class="sapUiSmallMarginBottom">
                            <Label text="Invoice ID:" /><Text id="rcptInvId" text="" />
                        </HBox>
                        <HBox justifyContent="SpaceBetween" class="sapUiSmallMarginBottom">
                            <Label text="Amount Paid:" /><Text id="rcptAmt" text="" />
                        </HBox>
                        <HBox justifyContent="SpaceBetween" class="sapUiSmallMarginBottom">
                            <Label text="Payment Date:" /><Text id="rcptDate" text="" />
                        </HBox>
                        <HBox justifyContent="SpaceBetween" class="sapUiSmallMarginBottom">
                            <Label text="Payment Mode:" /><Text id="rcptMode" text="" />
                        </HBox>
                        <HBox justifyContent="SpaceBetween">
                            <Label text="Status:" />
                            <ObjectStatus id="rcptStatus" text="" state="Success" />
                        </HBox>
                    </VBox>
                </content>
                <endButton>
                    <Button text="{i18n>btnClose}" press=".onCloseReceipt" />
                </endButton>
            </Dialog>
        </dependents>

    </Page>
</mvc:View>

