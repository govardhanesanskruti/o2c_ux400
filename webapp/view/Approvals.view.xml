<mvc:View
    controllerName="o2c.controller.Approvals"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core">

    <Page title="{i18n>pageApprovals}">
        <customHeader>
            <Bar>
                <contentLeft>
                    <Button icon="sap-icon://nav-back" press=".navBack" />
                    <Title text="{i18n>pageApprovalWorkbench}" />
                </contentLeft>
                <contentRight>
                    <Select id="approvalFilter" change=".onFilterChange">
                        <core:Item key="All" text="{i18n>all}" />
                        <core:Item key="Pending" text="{i18n>statusPending}" />
                        <core:Item key="Approved" text="{i18n>statusApproved}" />
                        <core:Item key="Rejected" text="{i18n>statusRejected}" />
                    </Select>
                </contentRight>
            </Bar>
        </customHeader>

        <content>
            <VBox class="sapUiMediumMargin">

                <!-- Summary Info Bars -->
                <HBox class="sapUiSmallMarginBottom" wrap="Wrap">
                    <ObjectStatus text="{i18n>dashPendingApprovals}" state="Warning" class="sapUiSmallMarginEnd"
                                  icon="sap-icon://pending" />
                    <ObjectStatus text="{i18n>labelTotalRecords}" state="None" class="sapUiSmallMarginEnd"
                                  icon="sap-icon://list" />
                </HBox>

                <Table id="approvalsTable" items="{/approvals}"
                       noDataText="{i18n>noApprovals}"
                       mode="SingleSelectLeft" selectionChange=".onApprovalSelect">
                    <headerToolbar>
                        <Toolbar>
                            <Title text="{i18n>pageApprovals}" />
                            <ToolbarSpacer />
                            <Button id="btnBulkApprove" text="{i18n>btnApproveSelected}"
                                    icon="sap-icon://accept" type="Accept"
                                    press=".onBulkApprove" enabled="false" />
                        </Toolbar>
                    </headerToolbar>
                    <columns>
                        <Column width="8rem"><Text text="{i18n>colApprovalId}" /></Column>
                        <Column width="10rem"><Text text="{i18n>colOrderId}" /></Column>
                        <Column hAlign="Center"><Text text="{i18n>colDecision}" /></Column>
                        <Column><Text text="{i18n>colRemarks}" /></Column>
                        <Column><Text text="{i18n>colApprovedBy}" /></Column>
                        <Column><Text text="{i18n>colApprovedOn}" /></Column>
                        <Column hAlign="Center"><Text text="{i18n>colActions}" /></Column>
                    </columns>
                    <items>
                        <ColumnListItem type="Active" press=".onApprovalPress">
                            <cells>
                                <ObjectIdentifier title="{ApprovalId}" />
                                <Link text="{OrderId}" press=".onOrderLink" />
                                <ObjectStatus text="{Decision}" state="{path:'Decision', formatter:'.formatStatusState'}" />
                                <Text text="{Remarks}" wrapping="true" maxLines="2" />
                                <Text text="{ApprovedBy}" />
                                <Text text="{ApprovedOn}" />
                                <HBox>
                                    <Button text="{i18n>btnApprove}" icon="sap-icon://accept" type="Accept"
                                            press=".onApprove"
                                            visible="{= ${Decision} === 'Pending'}" />
                                    <Button text="{i18n>btnReject}" icon="sap-icon://decline" type="Reject"
                                            press=".onReject"
                                            visible="{= ${Decision} === 'Pending'}"
                                            class="sapUiTinyMarginBegin" />
                                </HBox>
                            </cells>
                        </ColumnListItem>
                    </items>
                </Table>
            </VBox>
        </content>

        <!-- Approval Dialog -->
        <dependents>
            <Dialog id="approvalDialog" title="{i18n>dialogProcessApproval}" contentWidth="480px">
                <content>
                    <VBox class="sapUiSmallMargin">
                        <Label text="{i18n>colOrderId}" />
                        <Text id="dlgOrderId" text="" class="sapUiSmallMarginBottom" />
                        <Label text="{i18n>colDecision}" required="true" />
                        <Select id="dlgDecision" class="sapUiSmallMarginBottom">
                            <core:Item key="Approved" text="âœ… Approve" />
                            <core:Item key="Rejected" text="âŒ Reject" />
                        </Select>
                        <Label text="{i18n>colRemarks}" required="true" />
                        <TextArea id="dlgRemarks" rows="4"
                                  placeholder="{i18n>phApprovalRemarks}" />
                    </VBox>
                </content>
                <beginButton>
                    <Button text="{i18n>btnSubmitDecision}" type="Emphasized" press=".onSubmitDecision" />
                </beginButton>
                <endButton>
                    <Button text="{i18n>btnCancel}" press=".onCancelDecision" />
                </endButton>
            </Dialog>
        </dependents>
    </Page>
</mvc:View>

